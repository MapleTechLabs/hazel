{
	"name": "@hazel/client-data",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./platform": "./src/platform/index.ts",
		"./web": "./src/platform/web/index.ts",
		"./web/*": "./src/platform/web/*.ts",
		"./jsc": "./src/platform/jsc/index.ts",
		"./*": "./src/*.ts"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "effect-tsgo tsrs --noEmit",
		"verify:F": "bun run typecheck && vitest run && bun run --cwd ../../apps/ios-hybrid build:effect-ui:live && bash ../../apps/ios-hybrid/scripts/test-hazelui.sh F"
	},
	"dependencies": {
		"@hazel/domain": "workspace:*",
		"@hazel/effect-db-collection": "workspace:*",
		"@hazel/schema": "workspace:*",
		"@tanstack/browser-db-sqlite-persistence": "1.0.0-rc.1.5",
		"@tanstack/db": "1.0.0-rc.1.5",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"typescript": "catalog:tooling"
	}
}
