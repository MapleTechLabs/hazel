{
	"extends": "../../../../tsconfig.base.json",
	"include": ["./*.ts"],
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"]
	}
}
