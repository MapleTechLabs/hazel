{
	"name": "@hazel/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/tables/index.ts",
		"./tables": "./src/tables/index.ts",
		"./stores": "./src/stores.ts",
		"./node": "./src/node.ts"
	},
	"scripts": {
		"db:generate-sqlite": "bun scripts/generate-sqlite.ts",
		"test": "vitest run && vitest run --config vitest.workerd.config.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/workerd",
		"test:workerd": "vitest run --config vitest.workerd.config.ts"
	},
	"dependencies": {
		"@effect/sql-d1": "catalog:effect",
		"@effect/sql-sqlite-node": "catalog:effect",
		"@hazel/domain": "workspace:*",
		"@hazel/schema": "workspace:*",
		"@maple-dev/effect-orm": "0.8.0",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.9",
		"@cloudflare/workers-types": "catalog:alchemy",
		"@effect/sql-sqlite-do": "catalog:effect",
		"@types/bun": "1.4.3",
		"@types/node": "^24.19.2",
		"typescript": "catalog:tooling",
		"vitest": "^5.0.5"
	}
}
