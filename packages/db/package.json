{
	"name": "@hazel/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/tables/index.ts",
		"./tables": "./src/tables/index.ts",
		"./stores": "./src/stores.ts",
		"./node": "./src/node.ts"
	},
	"scripts": {
		"db:generate-sqlite": "bun scripts/generate-sqlite.ts && oxfmt src/migrations.generated.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/sql-d1": "catalog:effect",
		"@effect/sql-sqlite-node": "catalog:effect",
		"@hazel/domain": "workspace:*",
		"@hazel/schema": "workspace:*",
		"@maple-dev/effect-orm": "0.8.0",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@types/bun": "1.3.9",
		"@types/node": "^24",
		"typescript": "catalog:tooling"
	}
}
