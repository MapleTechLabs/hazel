{
	"extends": "../../tsconfig.base.json",
	"include": ["src/**/*.ts", "scripts/**/*.ts", "*.config.ts"],
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"types": ["node"]
	}
}
