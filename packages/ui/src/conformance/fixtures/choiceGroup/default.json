{
	"about": "Phase 4 contract addition (`docs/hazel-ui-phase4.md`): theme mode in each style: radio rows, cards in columns, segmented, chips (several), swatches.",
	"root": {
		"tag": "choiceGroup",
		"props": {
			"label": "Theme",
			"options": [
				{
					"value": "light",
					"label": "Light",
					"icon": "sun"
				},
				{
					"value": "dark",
					"label": "Dark",
					"icon": "moon"
				},
				{
					"value": "system",
					"label": "System",
					"description": "Follow the device",
					"disabled": false
				}
			],
			"selected": ["dark"]
