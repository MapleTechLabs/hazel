				"options": [
					{
						"value": "open",
						"label": "Open",
						"badge": 12
					},
					{
						"value": "snoozed",
						"label": "Snoozed",
						"badge": 3
					},
					{
						"value": "done",
						"label": "Done"
					}
				],
				"selected": ["open"]
			}
		},
		{
			"name": "option-disabled",
			"props": {
				"style": "chips",
				"options": [
					{
						"value": "mon",
						"label": "Mon"
					},
					{
						"value": "tue",
						"label": "Tue",
						"disabled": true
					},
					{
						"value": "wed",
						"label": "Wed"
					}
				],
				"selected": ["mon"],
				"multiple": true
			}
