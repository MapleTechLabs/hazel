		"events": ["change"]
	},
	"frame": "sidebar",
	"axes": [
		{
			"prop": "style",
			"values": ["cards", "segmented", "chips"]
		},
		{
			"prop": "columns",
			"values": ["2", "3"]
		}
	],
	"cases": [
