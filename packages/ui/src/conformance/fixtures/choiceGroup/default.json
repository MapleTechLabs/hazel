		},
		{
			"name": "swatches",
			"props": {
				"style": "swatches",
				"options": [
					{
						"value": "brand",
						"label": "Purple",
						"swatch": "#6938EF"
					},
					{
						"value": "ocean",
						"label": "Ocean",
						"swatch": "#0E7490"
					}
				],
				"selected": ["brand"]
			}
		},
		{
			"name": "error",
			"props": {
				"error": "Pick one",
				"description": "Applies to every device",
				"selected": []
			}
		},
		{
			"name": "disabled",
			"props": {
				"disabled": true
			}
		},
		{
			"name": "checkbox-rows",
			"props": {
				"multiple": true,
				"selected": ["light", "system"]
			}
		},
		{
			"name": "cards-grid",
			"props": {
				"style": "cards",
				"columns": "2",
				"options": [
					{
						"value": "chat",
						"label": "Team chat",
						"description": "Channels, threads and DMs",
						"icon": "chat"
					},
					{
						"value": "support",
						"label": "Customer support",
						"description": "Shared inboxes and SLAs",
						"icon": "bell"
					},
					{
						"value": "eng",
						"label": "Engineering",
						"description": "Incidents and on-call",
						"icon": "code"
					}
				],
				"selected": ["support"]
			}
		},
		{
			"name": "cards-multiple",
			"props": {
				"style": "cards",
				"columns": "3",
				"multiple": true,
				"selected": ["light", "system"]
			}
		},
		{
			"name": "segmented-badges",
			"props": {
				"style": "segmented",
