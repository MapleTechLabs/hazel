			"label": "More actions",
			"entries": [
				{
					"entries": [
						{ "id": "reply", "label": "Reply", "icon": "reply" },
						{ "id": "thread", "label": "Reply in thread", "icon": "thread" },
						{ "id": "edit", "label": "Edit", "icon": "edit" },
						{ "id": "delete", "label": "Delete", "icon": "trash", "destructive": true }
