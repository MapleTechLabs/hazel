{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": [".context/**"],
	"ignoreExportsUsedInFile": true,
	"workspaces": {
		".": {
			"entry": ["alchemy.run.ts", "scripts/**/*.ts", "scripts/oxlint-plugins/*.mjs"],
			"ignoreBinaries": ["infisical"],
			// The Effect language service's plugin id in `tsconfig.base.json`: `effect-tsgo` (`@effect/tsgo`)
			// implements it, there is no such package to install.
			// `tsrs` is never run directly: `effect-tsgo tsrs` (every `typecheck`) reads its installed version
			// to pick the Effect-patched tsrs build it runs, so this devDependency is the version pin.
			"ignoreDependencies": ["@effect/language-service", "tsrs"]
		},
		"apps/backend": {
			// The folder's map (`objects/` and what lives where); nothing imports the barrel.
			"ignore": ["src/worker/objects/index.ts"]
		},
		"apps/bot-gateway": {
			"entry": ["alchemy.run.ts"]
		},
		"apps/docs": {
			// Not in the root stack yet: docs.hazel.sh still serves from Vercel.
			"entry": ["alchemy.run.ts"]
		},
		"apps/landing": {
			// Kept for the hero video and quote section, both commented out in their pages.
			"ignore": [
				"src/components/react/HeroVideoDialog.tsx",
				"src/components/sections/QuoteSection.astro"
			]
		},
		"libs/bot-sdk": {
			// Run by hand (`bun run index.ts`) to try the SDK; not imported by anything.
			"entry": ["examples/*/index.ts"]
		},
		"apps/link-preview-worker": {
			"entry": ["alchemy.run.ts"]
		},
		"apps/ios-hybrid": {
			// The JavaScriptCore bundles (`build:effect-ui`, `build:effect-ui:live`, `build:hazel`) and the
			// build scripts.
			"entry": ["effect-ui/entry.ts", "effect-ui/live-entry.ts", "script/entry.ts", "scripts/**/*.ts"],
			// `export-icons.ts` rasterizes through Xcode's `swift`, a system tool, not a package.
			"ignoreBinaries": ["swift"],
			// web-foldkit's Vite config (which this package's spreads) imports these, resolved here.
			"ignoreDependencies": ["foldkit", "@foldkit/vite-plugin"]
		},
		"packages/ui": {
			// Codegen and stub scripts run by hand or from package scripts.
			"entry": ["scripts/**/*.ts"],
			// The parity gallery draws today's kit through web-foldkit's own foldkit (tsconfig paths).
			"ignoreDependencies": ["foldkit"]
		},
		"apps/raycast": {
			// Raycast provides React to extensions at runtime.
			"ignoreDependencies": ["react"]
		},
		"apps/web-foldkit": {
			// `src/parity/pages/*.ts`: the parity harness's registry, loaded by `compare-pages.ts` from disk.
			"entry": [
				"alchemy.run.ts",
				"src/main.ts",
				"public/sw.js",
				"scripts/*.ts",
				"src/parity/pages/*.ts"
			],
			// @foldkit/devtools is loaded by @foldkit/vite-plugin's dev overlay; the oxlint plugin by
			// path from the root .oxlintrc.json.
			"ignoreDependencies": ["@foldkit/devtools", "@foldkit/oxlint-plugin"]
		},
		"bots/*": {
			"entry": ["alchemy.run.ts"]
		},
		"packages/auth": {
			"entry": ["scripts/**/*.ts"]
		},
		// The workerd suites' Worker, named by path in their vitest config.
		"packages/db": {
			"entry": ["test/workerd/worker.ts"],
			// `typecheck` runs `effect-tsgo tsrs -p test/workerd`, which knip does not read the config from.
			"typescript": { "config": ["tsconfig.json", "test/workerd/tsconfig.json"] }
		},
		"packages/sync-do": {
			"entry": ["test/workerd/worker.ts"],
			// `typecheck` runs `effect-tsgo tsrs -p test/workerd`, which knip does not read the config from.
			"typescript": { "config": ["tsconfig.json", "test/workerd/tsconfig.json"] }
		},
		"packages/integrations": {
			"entry": ["scripts/**/*.ts"]
		}
	},
	"rules": {
		"files": "error",
		"dependencies": "error",
		"devDependencies": "error",
		"unlisted": "error",
		"binaries": "error",
		"unresolved": "error",
		"catalog": "error",
		"exports": "warn",
		"types": "warn",
		"nsExports": "warn",
		"nsTypes": "warn",
		"enumMembers": "warn",
		"namespaceMembers": "warn",
		"duplicates": "warn"
	}
}
