{
	"name": "hazel-chat",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*",
			"libs/*",
			"bots/*"
		],
		"catalogs": {
			"effect": {
				"effect": "4.0.6",
				"@effect/platform-bun": "4.0.6",
				"@effect/platform-browser": "4.0.6",
				"@effect/platform-node": "4.0.6",
				"@effect/sql-sqlite-node": "4.0.6",
				"@effect/sql-sqlite-do": "4.0.6",
				"@effect/sql-d1": "4.0.6",
				"@effect/opentelemetry": "4.0.6",
				"@effect/atom-react": "4.0.6",
				"@effect/ai-openrouter": "4.0.6",
				"@effect/vitest": "4.0.6"
			},
			"alchemy": {
				"@cloudflare/workers-types": "4.20260603.1",
				"@maple-dev/alchemy": "0.2.0",
				"alchemy": "2.0.0-beta.80"
			},
			"tooling": {
				"typescript": "^7.0.2"
			}
		}
	},
	"scripts": {
		"dev": "bun run alchemy:dev",
		"build": "turbo build typecheck",
		"start": "turbo start",
		"setup": "bun run packages/setup/src/index.ts",
		"setup:turbo": "turbo setup",
		"typecheck": "turbo build typecheck",
		"format": "oxfmt",
		"lint": "oxlint --disable-nested-config",
		"test": "vitest",
		"test:once": "vitest run",
		"test:debug": "vitest --inspect-brk --no-file-parallelism",
		"test:coverage": "vitest run --coverage --coverage.reporter=text",
		"alchemy:deploy:prd": "bun scripts/alchemy-deploy.ts --yes --adopt --stage ${HAZEL_STAGE:-prd}",
		"alchemy:plan:prd:local": "infisical run --env prod -- alchemy plan --adopt --stage prd",
		"alchemy:deploy:prd:local": "infisical run --env prod -- bun scripts/alchemy-deploy.ts --yes --adopt --stage prd",
		"alchemy:deploy:pr": "bun scripts/alchemy-deploy.ts --yes --adopt --stage pr-${PR_NUMBER}",
		"alchemy:destroy:pr": "alchemy destroy --yes --stage pr-${PR_NUMBER}",
		"alchemy:dev": "ALCHEMY_LOCAL_STATE=1 alchemy dev --stage dev_${USER} --env-file .env.local",
		"alchemy:typecheck": "tsc -p tsconfig.alchemy.json"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "catalog:alchemy",
		"@effect/vitest": "catalog:effect",
		"@hazel/infra": "workspace:*",
		"@maple-dev/alchemy": "catalog:alchemy",
		"@rolldown/plugin-babel": "^0.2.1",
		"@types/node": "^24",
		"@vitest/coverage-v8": "^4.1.0",
		"alchemy": "catalog:alchemy",
		"effect": "catalog:effect",
		"oxfmt": "^0.40.0",
		"oxlint": "^1.55.0",
		"rollup-plugin-visualizer": "7.0.1",
		"turbo": "^2.8.16",
		"typescript": "catalog:tooling",
		"vitest": "^4.1.0",
		"wrangler": "^4.73.0"
	},
	"engines": {
		"bun": ">=1.2.14"
	},
	"packageManager": "bun@1.3.10",
	"trustedDependencies": []
}
