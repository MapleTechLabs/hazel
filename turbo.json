{
	"$schema": "https://turborepo.com/schema.json",
	"globalEnv": [
		"PORT",
		"BOT_TOKEN",
		"LISTEN_PORT",
		"LISTEN_HOST",
		"DATABASE_URL",
		"CLUSTER_URL",
		"EFFECT_DATABASE_URL",
		"BACKEND_URL",
		"INTERNAL_SECRET",
		"CLERK_SECRET_KEY",
		"COOKIE_DOMAIN",
		"S3_BUCKET",
		"S3_ENDPOINT",
		"S3_ACCESS_KEY_ID",
		"S3_SECRET_ACCESS_KEY",
		"ELECTRIC_URL",
		"ELECTRIC_SOURCE_SECRET",
		"ELECTRIC_SOURCE_ID",
		"ALLOWED_ORIGIN",
		"INTEGRATION_ENCRYPTION_KEY",
		"INTEGRATION_ENCRYPTION_KEY_VERSION",
		"LINEAR_CLIENT_ID",
		"LINEAR_CLIENT_SECRET",
		"DISCORD_CLIENT_ID",
		"DISCORD_CLIENT_SECRET",
		"DISCORD_BOT_TOKEN",
		"DISCORD_GATEWAY_ENABLED",
		"DISCORD_GATEWAY_INTENTS",
		"API_BASE_URL",
		"FRONTEND_URL",
		"REDIS_URL",
		"GITHUB_APP_ID",
		"GITHUB_APP_PRIVATE_KEY",
		"GITHUB_APP_SLUG",
		"GITHUB_WEBHOOK_SECRET",
		"OTEL_ENVIRONMENT",
		"OTEL_BASE_URL",
		"OTEL_SERVICE_NAME",
		"MAPLE_INGEST_KEY",
		"RAILWAY_GIT_COMMIT_SHA",
		"COMMIT_SHA",
		"OPENROUTER_API_KEY",
		"RIVET_URL"
	],
	"globalPassThroughEnv": ["*"],
	"ui": "tui",
	"tasks": {
		"build": {
			"outputs": ["dist/**", ".vercel/output/**"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"setup": {
			"cache": false,
			"dependsOn": ["^setup"]
		},
		"dev": {
			"persistent": true,
			"cache": false
		},
		"start": {
			"dependsOn": ["^build"],
			"persistent": true,
			"cache": false
		}
	}
}
