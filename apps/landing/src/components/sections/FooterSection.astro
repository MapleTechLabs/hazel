---
import { Icons } from "@/components/react/Icons";
import { FlickeringGrid } from "@/components/react/FlickeringGrid";
import { siteConfig } from "@/lib/config";
---

<footer id="footer" class="w-full pb-0">
  <div
    class="flex flex-col py-14 px-10 md:flex-row md:justify-between gap-8 md:gap-0"
  >
    <div class="mx-0 flex md:max-w-xs flex-col items-start justify-start pl-4 gap-y-3">
      <a href="/" class="flex items-center gap-2">
        <Icons.logo className="size-8" />
        <p class="font-semibold text-primary text-xl">Hazel</p>
      </a>
      <p class="font-medium text-muted-foreground tracking-tight">
        {siteConfig.footerSection.description}
      </p>
      {
        siteConfig.footerSection.socialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center mt-2 gap-2 text-sm font-medium text-muted-foreground hover:text-primary transition-colors"
          >
            <Icons.github className="size-4.5" />
            {link.title}
          </a>
        ))
      }
    </div>
    <div class="flex">
      <div
        class="grid grid-cols-3 gap-4 md:flex items-start justify-start  gap-y-5 md:flex-row md:items-center md:justify-between pl-4 lg:pl-10"
      >
        {
          siteConfig.footerSection.footerLinks.map((column) => (
            <ul class="flex flex-col h-full items-start justify-start">
              <span class="mb-2 font-semibold text-primary text-sm">
                {column.title}
              </span>
              {column.links.map((link) => (
                <li class="group inline-flex cursor-pointer items-center mb-2 justify-start gap-1.5 text-[15px]/snug text-muted-foreground">
                  <a href={link.url} class="flex items-center gap-1.5">
                    {link.title}
                  </a>
                  <div class="flex size-4 translate-x-0 transform items-center justify-center rounded border border-border opacity-0 transition-all duration-300 ease-out group-hover:translate-x-1 group-hover:opacity-100">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-4 w-4"
                    >
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </div>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </div>
  <div class="relative z-0 mt-24 h-48 w-full md:h-64">
    <div
      class="absolute inset-0 z-10 bg-gradient-to-t from-40% from-transparent to-background"
    >
    </div>
    <div class="absolute inset-0 mx-6">
      <FlickeringGrid
        text="Empower your Team"
        fontSize={90}
        className="h-full w-full"
        squareSize={2}
        gridGap={3}
        color="#6B7280"
        maxOpacity={0.3}
        flickerChance={0.1}
        client:visible
      />
    </div>
  </div>
</footer>

<script>
  // Handle responsive text for FlickeringGrid
  // This is a simple approach - you could also make FlickeringGrid accept props dynamically
  const updateFlickeringText = () => {
    // Placeholder for responsive behavior
  };

  if (typeof window !== "undefined") {
    updateFlickeringText();
    window.addEventListener("resize", updateFlickeringText);
  }
</script>
