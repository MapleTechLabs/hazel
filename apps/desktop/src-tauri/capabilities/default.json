{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "The app's own pages: the keychain vault, links, notifications and settings",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:window:allow-start-dragging",
		"core:window:allow-toggle-maximize",
		"allow-auth-vault-read",
		"allow-auth-vault-write",
		"deep-link:default",
		"opener:default",
		"notification:default",
		"store:default"
	]
}
