{
	"name": "@hazel/backend",
	"private": true,
	"type": "module",
	"module": "src/worker.ts",
	"exports": {
		".": "./src/worker.ts",
		"./api": "./src/api.ts",
		"./rpc/groups/*": "./src/rpc/groups/*.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
		"test": "vitest run src/**/*.test.ts",
		"test:sync": "vitest run src/services/chat-sync",
		"test:watch": "vitest src/**/*.test.ts",
		"test:policies": "vitest run src/lib/policy-utils.test.ts src/policies/*.test.ts",
		"dev:sign-in": "bun run src/scripts/dev-sign-in.ts"
	},
	"dependencies": {
		"@clerk/backend": "^3.3.0",
		"@effect/opentelemetry": "catalog:effect",
		"@effect/sql-sqlite-do": "catalog:effect",
		"@hazel/auth": "workspace:*",
		"@hazel/backend-core": "workspace:*",
		"@hazel/bot-gateway": "workspace:*",
		"@hazel/db": "workspace:*",
		"@hazel/domain": "workspace:*",
		"@hazel/effect-cloudflare": "workspace:*",
		"@hazel/infra": "workspace:*",
		"@hazel/integrations": "workspace:*",
		"@hazel/schema": "workspace:*",
		"@hazel/sync-do": "workspace:*",
		"@yielded/auth": "0.1.0-beta.38",
		"alchemy": "catalog:alchemy",
		"aws4fetch": "^1.0.20",
		"dfx": "^1.1.0",
		"effect": "catalog:effect",
		"jose": "^6.1.3",
		"uuid": "^13"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "catalog:alchemy",
		"@effect/platform-node": "catalog:effect",
		"@types/bun": "1.3.9",
		"typescript": "catalog:tooling"
	}
}
