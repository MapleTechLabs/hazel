# Database Configuration
# Local Docker PostgreSQL (recommended for development)
DATABASE_URL=postgresql://user:password@localhost:5432/app

# For production/remote database, use:
# DATABASE_URL=postgresql://user:password@your-db-host:6432/postgres?sslmode=verify-full

# Cluster Service URL
# Local cluster service (Docker)
CLUSTER_URL=http://localhost:3020

# Clerk Authentication
# Get these from: https://dashboard.clerk.com/ → API Keys
CLERK_SECRET_KEY=sk_test_your_clerk_secret_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_here
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret_here

# Hazel sign-in (replacing Clerk). Off until AUTH_GITHUB_CLIENT_ID is set.
# GitHub OAuth App callback URL: {API_BASE_URL}/auth/github/callback
# Google OAuth client redirect URI: {API_BASE_URL}/auth/google/callback
# Generate the keys with: bun run --cwd packages/auth generate-keys
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_BINDING_KEY=
# AUTH_TRANSACTION_KEY=
# AUTH_ACCESS_TOKEN_KID=
# AUTH_ACCESS_TOKEN_PRIVATE_JWK=

# S3-Compatible Storage (e.g., Cloudflare R2)
# Bun auto-reads these S3_* env vars (or AWS_* as fallback)
# Get these from your S3-compatible storage provider dashboard
S3_BUCKET=your-bucket-name
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key

# Electric SQL Configuration
# Local Electric (Docker)
ELECTRIC_URL=http://localhost:5133

# For Electric Cloud (production), use:
# ELECTRIC_URL=https://api.electric-sql.cloud
# ELECTRIC_SECRET=your_electric_jwt_token
# ELECTRIC_SOURCE_ID=your_source_id

LINEAR_CLIENT_ID=your_client_id
LINEAR_CLIENT_SECRET=your_client_secret
LINEAR_REDIRECT_URI=http://localhost:3003/integrations/linear/callback

DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GATEWAY_ENABLED=true
DISCORD_GATEWAY_INTENTS=34305

# Klipy GIF Search
KLIPY_API_KEY=your_klipy_api_key_here

API_BASE_URL=http://localhost:3003

# Frontend URL for auth redirects
FRONTEND_URL=http://localhost:3000

# Redis (for rate limiting)
# Uses the cache_redis service from docker-compose.yaml
REDIS_URL=redis://localhost:6380
