{
	"name": "@hazel/ios-hybrid",
	"private": true,
	"type": "module",
	"scripts": {
		"build:web": "vite build --config web/vite.config.mts",
		"build:effect-ui": "bun build effect-ui/entry.ts --target=browser --format=iife --minify --outfile=build/effect-ui/effect-ui.js",
		"build:effect-ui:live": "bun build effect-ui/live-entry.ts --target=browser --format=iife --minify --outfile=build/effect-ui/effect-ui.js",
		"fixture-backend": "bun scripts/fixture-backend.ts",
		"ios": "bash scripts/build-hazel.sh",
		"build:web:offline": "vite build --config web/vite.config.mts --mode offline",
		"serve-fixture-html": "bun scripts/serve-fixture-html.ts",
		"test": "vitest run",
		"typecheck": "effect-tsgo tsrs --noEmit",
		"test:hazelui": "bash scripts/test-hazelui.sh",
		"verify:S0": "bash scripts/test-hazelui.sh S0 && bash scripts/build-effect-ui.sh",
		"verify:S1": "bash scripts/test-hazelui.sh S1",
		"verify:S2": "bash scripts/test-hazelui.sh S2",
		"verify:S3": "bash scripts/test-hazelui.sh S3",
		"verify:S4": "bash scripts/test-hazelui.sh S4",
		"verify:S5": "bash scripts/test-hazelui.sh S5",
		"build:hazel": "bun build script/entry.ts --target=browser --format=iife --minify --define 'import.meta={\"env\":{}}' --define __HAZEL_DEMO__=false --outfile=build/script/hazel.js",
		"build:hazel:demo": "bun build script/entry.ts --target=browser --format=iife --minify --define 'import.meta={\"env\":{}}' --define __HAZEL_DEMO__=true --outfile=build/script/hazel.js"
	},
	"dependencies": {
		"@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@4d6d7ec",
		"@hazel/auth": "workspace:*",
		"@hazel/client-data": "workspace:*",
		"@hazel/domain": "workspace:*",
		"@hazel/effect-db-collection": "workspace:*",
		"@hazel/schema": "workspace:*",
		"@hazel/shared-screens": "workspace:*",
		"@tanstack/db": "1.0.0-rc.1.5",
		"@yielded/auth": "0.1.0-beta.47",
		"effect": "catalog:effect",
		"foldkit": "0.171.0"
	},
	"devDependencies": {
		"@foldkit/vite-plugin": "0.29.1",
		"@types/node": "^24.19.2",
		"vite": "8.3.8",
		"vitest": "^5.1.1"
	}
}
