{
	"name": "@hazel/ios-hybrid",
	"private": true,
	"type": "module",
	"scripts": {
		"build:web": "vite build --config web/vite.config.mts",
		"ios": "bun run build:web && bash scripts/run.sh",
		"build:web:offline": "vite build --config web/vite.config.mts --mode offline",
		"serve-fixture-html": "bun scripts/serve-fixture-html.ts",
		"test": "vitest run",
		"typecheck": "effect-tsgo tsrs --noEmit"
	},
	"dependencies": {
		"@hazel/auth": "workspace:*",
		"@hazel/domain": "workspace:*",
		"@hazel/effect-db-collection": "workspace:*",
		"@hazel/schema": "workspace:*",
		"effect": "catalog:effect",
		"foldkit": "0.170.0"
	},
	"devDependencies": {
		"@foldkit/vite-plugin": "0.29.0",
		"@types/node": "^24.19.2",
		"vite": "8.3.5",
		"vitest": "^5.0.5"
	}
}
