    },
    {
      "batch": {"v": 1, "seq": 2, "ops": [
        ["props", 2, {"badge": 4, "meta": null, "isSelected": true}]
      ]},
      "expect": [
        "#root#0",
        "  hz:section#1",
        "    hz:item#2 {badge=4,isSelected=true,title=\"general\"}"
