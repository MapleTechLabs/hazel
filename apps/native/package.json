{
	"name": "@hazel/native",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun build src/entry.ts --target=bun --outdir dist --minify --external jsdom --external @tailwindcss/oxide --external @tailwindcss/node --external lightningcss --external postcss --external prismjs && bun scripts/precompile-styles.ts",
		"host:build": "cd host && cargo build --release",
		"start": "bun run host:build && host/target/release/hazel-native",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"bench": "bun bench/run.ts",
		"conformance": "bun bench/conformance/run.ts"
	},
	"dependencies": {
		"@hazel/auth": "workspace:*",
		"@hazel/domain": "workspace:*",
		"@hazel/effect-db-collection": "workspace:*",
		"@hazel/foldkit-rune": "workspace:*",
		"@hazel/schema": "workspace:*",
		"@tailwindcss/node": "4.3.3",
		"@tailwindcss/oxide": "4.3.3",
		"effect": "catalog:effect",
		"foldkit": "0.170.0",
		"jsdom": "^30.1.3",
		"postcss": "8.5.32",
		"prismjs": "^1.30.0",
		"prosemirror-model": "^1.25.12",
		"prosemirror-state": "^1.4.4",
		"prosemirror-view": "^1.42.6"
	},
	"devDependencies": {
		"@foldkit/vite-plugin": "0.29.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/jsdom": "^21.1.7",
		"@types/node": "^24.19.2",
		"playwright": "1.64.1",
		"typescript": "catalog:tooling",
		"vite": "8.0.0",
		"vitest": "^4.0.0"
	}
}
