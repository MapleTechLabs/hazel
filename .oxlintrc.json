		{
			// Framework-free modules carried over from the React app: imperative singletons and
			// helpers, not Foldkit programs, so the Foldkit architecture rules do not apply.
			"files": ["apps/web-foldkit/src/core/**"],
			"rules": {
				"foldkit/no-impure-call-at-decision-time": "off",
				"foldkit/no-module-level-mutable-state": "off",
				"foldkit/no-switch-on-message-tag": "off"
			}
		},
		{
			// A test asserts on a fixture it just built, so `!` there documents the fixture
			// rather than hiding an unchecked value.
			"files": ["**/*.test.ts", "**/*.test.tsx", "**/test/**", "**/tests/**"],
			"rules": {
				"typescript/no-non-null-assertion": "off"
			}
		},
		{
			// Test cases that cannot catch a bug: assertion-free, existence-only, constant pins,
			// Tailwind class pins, source greps, exact command lists and SQL projection pins.
