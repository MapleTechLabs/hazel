# What `bun run alchemy:dev` reads (copy to .env.local, or run `bun run setup`).
# alchemy dev runs the Workers locally: the api Worker with its Durable Objects (org, channel, user)
# and the directory D1, the bot gateway, link preview, actors and the web app. Their state lives in
# `.alchemy/`. Only S3 needs a stand-in: `docker compose up -d` starts MinIO.

# --- Required -----------------------------------------------------------------------------------

# Uploads (presigned against the bucket's S3 API). Local MinIO from docker-compose.yaml:
S3_BUCKET=hazel
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/hazel
VITE_R2_PUBLIC_URL=http://localhost:9000/hazel

# Encrypts integration tokens. Generate: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY_VERSION=1

# --- Sign-in (off until AUTH_GITHUB_CLIENT_ID is set) -------------------------------------------
# GitHub OAuth App callback: {api url}/auth/github/callback; Google: {api url}/auth/google/callback
# Keys: bun run --cwd packages/auth generate-keys
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_BINDING_KEY=
# AUTH_TRANSACTION_KEY=
# AUTH_ACCESS_TOKEN_KID=
# AUTH_ACCESS_TOKEN_PRIVATE_JWK=
# AUTH_ACCESS_TOKEN_JWKS=

# --- Optional -----------------------------------------------------------------------------------

# Inter-app URLs of a dev stage (defaults shown)
# HAZEL_WEB_URL=http://localhost:3000
# HAZEL_API_URL=http://localhost:3003
# HAZEL_RIVET_URL=http://localhost:6420
# HAZEL_LINK_PREVIEW_URL=http://localhost:5471

# Integrations
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# DISCORD_GATEWAY_ENABLED=false

# Thread naming (OpenRouter) and GIF search
# OPENROUTER_API_KEY=
# KLIPY_API_KEY=

# Maple's OAuth tokens for the public API v1
# CLERK_SECRET_KEY=

# Enables POST /internal/import (apps/backend/src/scripts/import-postgres.ts)
# IMPORT_SECRET=
